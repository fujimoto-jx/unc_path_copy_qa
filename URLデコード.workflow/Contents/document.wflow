				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>シェルスクリプトを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

notify() {
  local msg="$1"
  local subtitle="$2"
  local scpt="/tmp/url_decode_notify_$$.scpt"
  local msg_esc="${msg//\\/\\\\\\\\}"
  local sub_esc="${subtitle//\\/\\\\\\\\}"
  echo "display notification \"${msg_esc}\" with title \"URLデコード\" subtitle \"${sub_esc}\"" &gt; "$scpt"
  osascript "$scpt"
  rm -f "$scpt"
}

copy_to_clipboard() {
  local text="$1"
  local text_esc="${text//\\/\\\\}"
  local text_esc2="${text_esc//\"/\\\"}"
  osascript -e "set the clipboard to \"${text_esc2}\""
}

# クリップボードから取得
input=$(osascript -e 'get the clipboard as text' 2>/dev/null)

if [ -z "$input" ]; then
  notify "クリップボードが空です" "変換失敗"
  exit 0
fi

# URLデコード（python3使用）
decoded=$(python3 -c "
import urllib.parse, sys
text = sys.stdin.read().strip()
print(urllib.parse.unquote(text), end='')
" &lt;&lt;&lt; "$input")

if [ $? -ne 0 ]; then
  notify "デコードに失敗しました" "変換失敗"
  exit 0
fi

# 変化がなければ通知
if [ "$decoded" = "$input" ]; then
  notify "デコードする文字列がありませんでした" "変換スキップ"
  exit 0
fi

copy_to_clipboard "$decoded"
notify "$decoded" "クリップボードにコピーしました"

exit 0</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>0</integer>
					<key>shell</key>
					<string>/bin/bash</string>
