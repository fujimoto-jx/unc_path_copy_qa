					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>シェルスクリプトを実行</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# URLデコード関数
urldecode() {
  local encoded="$1"
  printf '%b' "${encoded//%/\\x}"
}

notify() {
  local msg="$1"
  local subtitle="$2"
  local scpt="/tmp/unc_notify_$$.scpt"
  local msg_esc="${msg//\\/\\\\\\\\}"
  local sub_esc="${subtitle//\\/\\\\\\\\}"
  echo "display notification \"${msg_esc}\" with title \"UNCパス変換\" subtitle \"${sub_esc}\"" &gt; "$scpt"
  osascript "$scpt"
  rm -f "$scpt"
}

copy_to_clipboard() {
  local text="$1"
  local text_esc="${text//\\/\\\\}"
  local text_esc2="${text_esc//\"/\\\"}"
  osascript -e "set the clipboard to \"${text_esc2}\""
}

if [ "$#" -eq 0 ]; then
  notify "引数なし" "変換失敗"
  exit 0
fi

mounts="$(/sbin/mount | grep '(smbfs')"
if [ -z "$mounts" ]; then
  notify "SMBマウントが見つかりません" "変換失敗"
  exit 0
fi

mac_results=()
win_results=()

for p in "$@"; do
  matched=0
  while IFS= read -r line; do
    [ -z "$line" ] &amp;&amp; continue
    spec="$(echo "$line" | sed 's# on /.*##')"
    mnt="$(echo "$line"  | sed 's#.* on ##' | sed 's# (smbfs.*##')"

    case "$p" in
      "$mnt" | "$mnt"/*)
        rel="${p#$mnt}"

        # URLデコード（日本語パス対応）
        rel_decoded="$(urldecode "$rel")"

        # unc_body: ユーザー名(@以前)を除去しデコード
        unc_body="${spec#//}"
        unc_body="${unc_body##*@}"
        unc_body="$(urldecode "$unc_body")"

        # --- Mac用パス: smb://host/share/path ---
        # spec から // を除いたホスト+共有部分を使用
        mac_path="smb://${unc_body}${rel_decoded}"
        mac_results+=("$mac_path")

        # --- Win用パス: \\host\share\path ---
        win_body="$(echo "$unc_body" | tr '/' '\\')"
        win_rel="$(echo "$rel_decoded" | tr '/' '\\')"
        win_path="\\\\${win_body}${win_rel}"
        win_results+=("$win_path")

        matched=1
        break
        ;;
    esac
  done &lt; &lt;(echo "$mounts")

  if [ "$matched" -eq 0 ]; then
    notify "SMBマウント上のファイルではありません" "変換失敗"
  fi
done

if [ "${#mac_results[@]}" -gt 0 ]; then
  # Mac・Win両パスを改行区切りで結合してコピー
  if [ "${#mac_results[@]}" -eq 1 ]; then
    clip_text="Mac: ${mac_results[0]}
Win: ${win_results[0]}"
    notify_msg="${mac_results[0]}
${win_results[0]}"
  else
    clip_text=""
    notify_msg=""
    for i in "${!mac_results[@]}"; do
      clip_text+="Mac: ${mac_results[$i]}
Win: ${win_results[$i]}"
      if [ "$i" -lt $(( ${#mac_results[@]} - 1 )) ]; then
        clip_text+="
"
      fi
    done
    notify_msg="${mac_results[0]}
${win_results[0]} 他$((${#mac_results[@]} - 1))件"
  fi

  copy_to_clipboard "$clip_text"

  if [ "${#mac_results[@]}" -eq 1 ]; then
    notify "$notify_msg" "クリップボードにコピーしました"
  else
    notify "$notify_msg" "クリップボードにコピーしました（$((${#mac_results[@]}))件）"
  fi
fi

exit 0</string>
					<key>CheckedForUserDefaultShell</key>
